# Đổi tên file này thành tuvan.env rồi điền thông tin
# Địa chỉ Tailscale Funnel của Mac (lấy từ lệnh: tailscale funnel status)
PUBLIC_ORIGIN=https://ten-may.ten-mang.ts.net

# Mật khẩu Khu vực giáo viên (lưu hồ sơ, nhập Google Form, lấy tổ hợp từ web trường).
# Đặt mật khẩu dài, chỉ chia sẻ cho giáo viên. Để trống = tắt khu vực giáo viên.
TEACHER_PASSWORD=

# Nơi lưu hồ sơ học sinh và cơ sở dữ liệu trường (KHÔNG đặt trong thư mục web-demo)
DATA_DIR=$HOME/web-demo-data

# Số lượt hỏi trợ lý tối đa mỗi IP trong 10 phút
RATE_LIMIT=30

# Cổng của trạm trung gian (giữ nguyên nếu không trùng)
PROXY_PORT=8787

# Cổng nội bộ cho bot giáo viên kết nối (chỉ nghe 127.0.0.1, KHÔNG mở qua Funnel)
SERVICE_PORT=8788

# Khoá bí mật cho bot giáo viên kết nối vào cổng dịch vụ nội bộ (chuỗi ngẫu nhiên dài)
# Để trống = tắt cổng dịch vụ
BOT_SERVICE_TOKEN=

# Token của Bot Telegram riêng cho tư vấn (tạo từ @BotFather)
# Bắt buộc phải có để chạy server/tuvan_bot.py
TUVAN_BOT_TOKEN=

# Danh sách ID Telegram của các giáo viên được phép dùng bot (cách nhau bằng dấu phẩy)
# Ví dụ: 123456789,987654321
TEACHER_TELEGRAM_IDS=

# Địa chỉ cổng dịch vụ máy chủ nội bộ mà bot kết nối tới (mặc định http://127.0.0.1:8788)
SERVICE_URL=http://127.0.0.1:8788
